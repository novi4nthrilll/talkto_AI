# =============================================================
#  AI Web Agent — Environment Configuration
# =============================================================
#  Salin file ini menjadi `.env` lalu isi API key-nya.
#  Jangan pernah commit file `.env` ke repository!
# =============================================================

# --- LLM Providers (isi minimal satu) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Text-to-Speech ---
# Pilihan: edge-tts (default), gtts
TTS_ENGINE=edge-tts
# Suara edge-tts bahasa Indonesia (default: id-ID-ArdiNeural)
TTS_VOICE=id-ID-ArdiNeural

# --- Browser ---
# Headless mode (false = browser terlihat, supaya bisa solve captcha)
BROWSER_HEADLESS=false
# Batas langkah agent per sesi (default: 15)
MAX_STEPS=15

# --- Logging ---
# Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

