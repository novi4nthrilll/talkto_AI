# =============================================================
#  AI Web Agent — Environment Configuration
# =============================================================
#  Salin file ini menjadi `.env` lalu isi API key-nya.
#  Jangan pernah commit file `.env` ke repository!
# =============================================================

# --- LLM Providers (isi minimal satu) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Text-to-Speech ---
# Pilihan engine: edge-tts (default gratis), elevenlabs (paling luwes mirip manusia), openai, gtts
TTS_ENGINE=edge-tts
# Pilihan suara edge-tts:
# - id-ID-GadisNeural (suara cewek, sangat luwes & santai, disarankan)
# - id-ID-ArdiNeural (suara cowok, formal)
TTS_VOICE=id-ID-GadisNeural
# Kecepatan bicara (+10% lebih luwes seperti ngobrol santai)
TTS_RATE=+10%
# Hapus file audio secara permanen setelah selesai diputar (true/false)
AUTO_DELETE_AUDIO=true

# (Opsional) Jika pakai ElevenLabs (suara paling human-like di dunia, daftar di elevenlabs.io):
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Browser ---
# Headless mode (false = browser terlihat, supaya bisa solve captcha)
BROWSER_HEADLESS=false
# Batas langkah agent per sesi (default: 15)
MAX_STEPS=15

# --- Logging ---
# Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

